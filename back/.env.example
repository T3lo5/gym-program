# Treinos Backend - Environment Variables
# Copie este arquivo para .env e preencha os valores:
#   cp back/.env.example back/.env

# SenseNova API (obtenha em https://platform.sensenova.ai/console/keys)
# Usada apenas pelo endpoint /v1/generate-workout.
SENSENOVA_API_KEY=sk-your-key-here
SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
MODEL_ID=sensenova-6.8-flash-lite

# Orçamento total (deadline) da chamada de IA, em segundos. Default 80.
# Precisa ficar abaixo do read timeout do app (90s) com folga para o fallback
# local e a rede; aumentar além disso faz o app desistir antes da resposta.
#AI_TIMEOUT_TOTAL_SECONDS=80

# Descoberta automática na rede local (mDNS).
# Deixe true ao rodar direto no PC (sem Docker).
# O docker-compose.yml já define false, pois o Docker bridge não anuncia mDNS.
MDNS_ENABLED=true
