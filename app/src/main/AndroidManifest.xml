<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 15+ exige permissão para falar na rede local (descoberta mDNS do backend). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Vibração do fim do descanso (H3-26); permissão normal, sem prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".TreinosApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TreinosApp"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- H3-35: atalho dinâmico "Retomar treino" (publicado via ShortcutManagerCompat). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Wear OS Data Layer: recebe comandos do relógio -->
        <service
            android:name=".data.wear.WearCommandListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            tools:ignore="WearableBindListener">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>

            <!-- Wear OS companion: o app do celular é o host do relógio -->
            <meta-data
                android:name="com.google.android.wearable.standalone"
                android:value="false" />

        <!-- Persistência da escolha de idioma por app em versões < Android 13.
             autoStoreLocales=true é lido pelo AppCompat no attachBaseContext; sem esse
             meta-data o delegate falha com NPE (isAutoStorageOptedIn) no release. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        </application>
</manifest>
