<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 15+ exige permissão para falar na rede local (descoberta mDNS do backend). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Vibração do fim do descanso (H3-26); permissão normal, sem prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- H3-58: notificação do fim do descanso com o app em segundo plano;
         permissão runtime em API 33+, pedida quando um descanso começa. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- H3-51: o app dispara a instalação do APK baixado via instalador do
         sistema; sem essa permissão o toggle "instalar apps desconhecidos"
         não existe para o app e o update falha. O Android pede a permissão
         ao usuário no momento do primeiro update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- H3-57: opt-in do gesto preditivo (Android 13+). Com a flag ativa, o
         sistema mostra a prévia animada do back e a pilha de navegação decide
         quando voltar (PredictiveBackHandler em TreinosApp). -->
    <application
        android:name=".TreinosApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TreinosApp"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- H3-35: atalho dinâmico "Retomar treino" (publicado via ShortcutManagerCompat). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Wear OS Data Layer: recebe comandos do relógio -->
        <service
            android:name=".data.wear.WearCommandListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            tools:ignore="WearableBindListener">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>

            <!-- Wear OS companion: o app do celular é o host do relógio -->
            <meta-data
                android:name="com.google.android.wearable.standalone"
                android:value="false" />

        <!-- H3-51: compartilha o APK baixado com o instalador do sistema. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Persistência da escolha de idioma por app em versões < Android 13.
             autoStoreLocales=true é lido pelo AppCompat no attachBaseContext; sem esse
             meta-data o delegate falha com NPE (isAutoStorageOptedIn) no release. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        </application>
</manifest>
