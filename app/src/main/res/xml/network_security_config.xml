<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Local network ranges -->
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">169.254.0.0/16</domain>
        <!-- Localhost for adb reverse -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- mDNS local domains -->
        <domain includeSubdomains="true">*.local</domain>
    </domain-config>
    
    <!-- Allow HTTPS everywhere -->
    <domain-config>
        <domain includeSubdomains="true">token.sensenova.ai</domain>
        <domain includeSubdomains="true">platform.sensenova.ai</domain>
    </domain-config>
    
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>