<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        O destino HTTP é escolhido pelo usuário: IP da LAN, host *.local ou
        localhost (adb reverse). O Android não aceita faixas CIDR em <domain>
        (um <domain> é nome de host exato ou sufixo), então listar
        "192.168.0.0/16" não liberava nada e todo IP da LAN caía no
        base-config antigo, que proibia cleartext — daí o
        "Não foi possível falar com o backend" com o backend no ar.

        Como não há como enumerar a rede local, o cleartext é liberado no
        base-config. O único tráfego HTTP do app é o backend configurado pelo
        usuário; chamadas de IA passam por ele, não direto do aparelho.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
